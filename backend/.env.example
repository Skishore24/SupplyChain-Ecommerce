# ─── Project Identity ────────────────────────────────────────────────────────
PROJECT_NAME=SHOPERA
API_V1_STR=/api
ENVIRONMENT=development

# ─── Database ────────────────────────────────────────────────────────────────
# MySQL connection string — update with your credentials
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/ecommerce_db

# ─── Security & JWT ──────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── AI / LLM Provider ───────────────────────────────────────────────────────
# Set LLM_PROVIDER to "gemini" or "openai" — or leave as "none" to disable GenAI features.
# All SQL/ML/RAG features work without an LLM key.
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash

# ─── Embeddings ──────────────────────────────────────────────────────────────
# "local" uses sentence-transformers (no API key needed)
# "gemini" uses Gemini embedding API (requires GEMINI_API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Vector Database ─────────────────────────────────────────────────────────
# "chroma" = embedded ChromaDB (dev-friendly, no server needed)
# "qdrant" = Qdrant (production-ready)
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./data/vector_db
VECTOR_DB_COLLECTION=supply_chain_knowledge

# ─── ML / Forecasting ────────────────────────────────────────────────────────
MIN_DAYS_FOR_ML=30
MIN_DAYS_FOR_DL=90
MODEL_STORAGE_PATH=./ml/models

# ─── File Storage ────────────────────────────────────────────────────────────
KNOWLEDGE_UPLOAD_PATH=./data/knowledge
MAX_UPLOAD_SIZE_MB=50

# ─── Background Jobs ─────────────────────────────────────────────────────────
ENABLE_BACKGROUND_JOBS=true

# ─── Demo Mode ───────────────────────────────────────────────────────────────
# Set to true to allow seeding demo suppliers, inventory history, and knowledge docs
ENABLE_DEMO_MODE=true
